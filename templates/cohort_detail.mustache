{{!
    @template local_cohort_manager/cohort_detail

    Displays cohort detail with rename forms, the enrolment table, the modal that
    removes the cohort from one course and the modal that deletes the cohort.

    Context variables required:
    * cohort_id - The cohort ID
    * cohort_name - The cohort name (formatted for display)
    * cohort_name_raw - The raw cohort name (for the rename input and delete confirmation)
    * is_component_managed - Boolean, true when the cohort is owned by another component
                             (rename and delete are then hidden)
    * backurl - URL to go back to the cohort list
    * action_url - URL for action.php POST
    * sesskey - Session key for CSRF protection
    * has_enrolments - Boolean
    * enrolments - Array of: enrolid, courseid, course_fullname, course_shortname,
                             enrolurl, groupid, groupname, has_group, user_count

    Example context (json):
    {
        "cohort_id": 1,
        "cohort_name": "Cohort A",
        "cohort_name_raw": "Cohort A",
        "is_component_managed": false,
        "backurl": "/local/cohort_manager/index.php",
        "action_url": "/local/cohort_manager/action.php",
        "sesskey": "abc123",
        "has_enrolments": true,
        "enrolments": [
            {
                "enrolid": 10,
                "courseid": 5,
                "course_fullname": "Mathematics",
                "course_shortname": "MATH",
                "enrolurl": "/enrol/instances.php?id=5",
                "groupid": 3,
                "groupname": "Group A",
                "has_group": true,
                "user_count": 24
            }
        ]
    }
}}
<div class="local-cohort-manager-detail">

    {{! Back navigation }}
    <div class="mb-3">
        <a href="{{backurl}}" class="btn btn-link pl-0 ps-0">
            &laquo; {{#str}}backtocohortlist, local_cohort_manager{{/str}}
        </a>
    </div>

    {{#is_component_managed}}
    <div class="alert alert-info">
        {{#str}}componentmanagednotice, local_cohort_manager{{/str}}
    </div>
    {{/is_component_managed}}

    {{^is_component_managed}}
    {{! Cohort rename section }}
    <div class="card mb-4">
        <div class="card-header">
            <h3 class="card-title m-0">{{#str}}cohortnamesection, local_cohort_manager{{/str}}</h3>
        </div>
        <div class="card-body">
            <form method="post" action="{{action_url}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="renamecohort">
                <input type="hidden" name="cohortid" value="{{cohort_id}}">
                <div class="d-flex flex-wrap align-items-center gap-2 local-cohort-manager-gap">
                    <label for="cohortname" class="sr-only visually-hidden">
                        {{#str}}cohortname, local_cohort_manager{{/str}}
                    </label>
                    <input type="text" id="cohortname" name="cohortname"
                           value="{{cohort_name_raw}}" class="form-control mr-2 me-2" required>
                    <button type="submit" class="btn btn-primary">
                        {{#str}}renamecohort, local_cohort_manager{{/str}}
                    </button>
                </div>
            </form>
        </div>
    </div>
    {{/is_component_managed}}

    {{! Batch rename section }}
    {{#has_enrolments}}
    <div class="card mb-4">
        <div class="card-header">
            <h3 class="card-title m-0">{{#str}}batchrenamegroups, local_cohort_manager{{/str}}</h3>
        </div>
        <div class="card-body">
            <p class="text-muted">{{#str}}batchrenamedesc, local_cohort_manager{{/str}}</p>
            <form method="post" action="{{action_url}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="batchrename">
                <input type="hidden" name="cohortid" value="{{cohort_id}}">
                <div class="d-flex flex-wrap align-items-center gap-2 local-cohort-manager-gap">
                    <label for="batchgroupname" class="sr-only visually-hidden">
                        {{#str}}newgroupname, local_cohort_manager{{/str}}
                    </label>
                    <input type="text" id="batchgroupname" name="batchgroupname"
                           placeholder="{{#str}}newgroupname, local_cohort_manager{{/str}}"
                           class="form-control mr-2 me-2" required>
                    <span class="d-none" id="batchConfirmMsg">{{#str}}batchrenameconfirm, local_cohort_manager{{/str}}</span>
                    <button type="submit" class="btn btn-warning" id="batchRenameBtn">
                        {{#str}}batchrename, local_cohort_manager{{/str}}
                    </button>
                </div>
            </form>
        </div>
    </div>
    {{/has_enrolments}}

    {{! Enrolments table }}
    {{#has_enrolments}}
    <h3>{{#str}}enrolledcourses, local_cohort_manager{{/str}}</h3>
    <table class="table table-striped generaltable">
        <thead>
            <tr>
                <th>{{#str}}coursename, local_cohort_manager{{/str}}</th>
                <th>{{#str}}courseshortname, local_cohort_manager{{/str}}</th>
                <th>{{#str}}groupname, local_cohort_manager{{/str}}</th>
                <th>{{#str}}actions, local_cohort_manager{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#enrolments}}
            <tr>
                <td><a href="{{enrolurl}}">{{course_fullname}}</a></td>
                <td>{{course_shortname}}</td>
                <td>
                    {{#has_group}}
                        {{groupname}}
                    {{/has_group}}
                    {{^has_group}}
                        <span class="text-muted font-italic fst-italic">
                            {{#str}}nogroup, local_cohort_manager{{/str}}
                        </span>
                    {{/has_group}}
                </td>
                <td>
                    <div class="d-flex flex-wrap align-items-center gap-2 local-cohort-manager-gap">
                        {{#has_group}}
                        <form method="post" action="{{action_url}}"
                              class="d-flex flex-wrap align-items-center gap-2 local-cohort-manager-gap">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="renamegroup">
                            <input type="hidden" name="cohortid" value="{{cohort_id}}">
                            <input type="hidden" name="groupid" value="{{groupid}}">
                            <input type="text" name="groupname" value="{{groupname}}"
                                   class="form-control form-control-sm mr-1 me-1" required>
                            <button type="submit" class="btn btn-sm btn-secondary">
                                {{#str}}rename, local_cohort_manager{{/str}}
                            </button>
                        </form>
                        {{/has_group}}
                        {{^has_group}}
                        <form method="post" action="{{action_url}}"
                              class="d-flex flex-wrap align-items-center gap-2 local-cohort-manager-gap">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="creategroup">
                            <input type="hidden" name="cohortid" value="{{cohort_id}}">
                            <input type="hidden" name="enrolid" value="{{enrolid}}">
                            <button type="submit" class="btn btn-sm btn-success">
                                {{#str}}creategroup, local_cohort_manager{{/str}}
                            </button>
                        </form>
                        {{/has_group}}
                        {{! "S" for "supprimer": removes this cohort enrolment instance from the
                             course. The modal below is filled in from these data attributes. }}
                        <button type="button"
                                class="btn btn-sm btn-danger local-cohort-manager-remove-enrol"
                                data-toggle="modal" data-target="#removeEnrolModal"
                                data-bs-toggle="modal" data-bs-target="#removeEnrolModal"
                                data-enrolid="{{enrolid}}"
                                data-course="{{course_fullname}}"
                                data-group="{{groupname}}"
                                data-has-group="{{#has_group}}1{{/has_group}}{{^has_group}}0{{/has_group}}"
                                data-users="{{user_count}}"
                                title="{{#str}}removeenrolment, local_cohort_manager{{/str}}"
                                aria-label="{{#str}}removeenrolment, local_cohort_manager{{/str}}">
                            {{#str}}removeenrolmentshort, local_cohort_manager{{/str}}
                        </button>
                    </div>
                </td>
            </tr>
            {{/enrolments}}
        </tbody>
    </table>

    {{! Remove-enrolment confirmation modal, shared by every row of the table: the row's
         button fills in the course name, the number of users the instance enrols, the
         group block and the hidden enrol id. }}
    <div class="modal fade" id="removeEnrolModal" tabindex="-1" role="dialog"
         aria-labelledby="removeEnrolModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="removeEnrolModalLabel">
                        {{#str}}removeenrolment, local_cohort_manager{{/str}}
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal"
                            aria-label="{{#str}}closebuttontitle, core{{/str}}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form method="post" action="{{action_url}}" id="removeEnrolForm">
                    <div class="modal-body">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="deleteenrolment">
                        <input type="hidden" name="cohortid" value="{{cohort_id}}">
                        <input type="hidden" name="enrolid" value="" id="removeEnrolId">
                        <div class="alert alert-danger">
                            <p class="font-weight-bold fw-bold">
                                {{#str}}removeenrolmentwarning, local_cohort_manager{{/str}}
                            </p>
                            <ul class="mb-0">
                                <li>{{#str}}removeenrolmentconsequence1, local_cohort_manager{{/str}}</li>
                                <li>{{#str}}removeenrolmentconsequence2, local_cohort_manager{{/str}}</li>
                                <li>{{#str}}removeenrolmentconsequence3, local_cohort_manager{{/str}}</li>
                                <li>{{#str}}removeenrolmentconsequence4, local_cohort_manager{{/str}}</li>
                            </ul>
                        </div>
                        <p class="mb-1">{{#str}}removeenrolmentcourse, local_cohort_manager{{/str}}</p>
                        <p class="font-weight-bold fw-bold" id="removeEnrolCourse"></p>
                        <p class="mb-1">
                            {{#str}}removeenrolmentusers, local_cohort_manager{{/str}}
                            <span class="font-weight-bold fw-bold" id="removeEnrolUsers"></span>
                        </p>
                        <div id="removeEnrolGroupBlock">
                            <p class="mb-1">
                                {{#str}}removeenrolmentgroup, local_cohort_manager{{/str}}
                                <span class="font-weight-bold fw-bold" id="removeEnrolGroupName"></span>
                            </p>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="keepgroup"
                                       name="keepgroup" value="1">
                                <label class="form-check-label" for="keepgroup">
                                    {{#str}}keepgroup, local_cohort_manager{{/str}}
                                </label>
                                <div class="text-muted small">
                                    {{#str}}keepgroupdesc, local_cohort_manager{{/str}}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">
                            {{#str}}cancel, local_cohort_manager{{/str}}
                        </button>
                        <button type="submit" class="btn btn-danger">
                            {{#str}}confirmremoveenrolment, local_cohort_manager{{/str}}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {{/has_enrolments}}

    {{^has_enrolments}}
    <div class="alert alert-info">
        {{#str}}noenrolments, local_cohort_manager{{/str}}
    </div>
    {{/has_enrolments}}

    {{^is_component_managed}}
    {{! Delete cohort section }}
    <hr>
    <div class="mt-4">
        <button type="button" class="btn btn-danger"
                data-toggle="modal" data-target="#deleteModal"
                data-bs-toggle="modal" data-bs-target="#deleteModal">
            {{#str}}deletecohort, local_cohort_manager{{/str}}
        </button>
    </div>

    {{! Delete confirmation modal }}
    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">
                        {{#str}}deletecohort, local_cohort_manager{{/str}}
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal"
                            aria-label="{{#str}}closebuttontitle, core{{/str}}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form method="post" action="{{action_url}}" id="deleteCohortForm">
                    <div class="modal-body">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="deletecohort">
                        <input type="hidden" name="cohortid" value="{{cohort_id}}">
                        <div class="alert alert-danger">
                            {{#str}}deletewarning, local_cohort_manager{{/str}}
                        </div>
                        <p>{{#str}}deletetypename, local_cohort_manager{{/str}}</p>
                        <p class="font-weight-bold fw-bold">{{cohort_name}}</p>
                        <div class="mb-3">
                            <input type="text" id="confirmname" name="confirmname"
                                   class="form-control" autocomplete="off" required
                                   placeholder="{{#str}}deletetypeplaceholder, local_cohort_manager{{/str}}">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">
                            {{#str}}cancel, local_cohort_manager{{/str}}
                        </button>
                        <button type="submit" class="btn btn-danger" id="confirmDeleteBtn" disabled>
                            {{#str}}confirmdelete, local_cohort_manager{{/str}}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {{! Hidden element carrying the raw cohort name for JS comparison.
         Using a data-attribute ensures proper encoding/decoding by the browser. }}
    <span id="deleteExpectedName" data-name="{{cohort_name_raw}}" class="d-none"></span>
    {{/is_component_managed}}

    {{! JS to enable delete button only when name matches, and handle batch rename confirm }}
    {{#js}}
    (function() {
        // Delete confirmation: enable button only when typed name matches.
        // These elements are absent for component-managed cohorts.
        var input = document.getElementById('confirmname');
        var btn = document.getElementById('confirmDeleteBtn');
        var expectedholder = document.getElementById('deleteExpectedName');
        if (input && btn && expectedholder) {
            var expected = expectedholder.getAttribute('data-name');
            input.addEventListener('input', function() {
                btn.disabled = (input.value.trim() !== expected);
            });
        }

        // Remove-enrolment modal: fill it in from the row whose button was clicked.
        // Bootstrap opens the dialog from a listener delegated on the document, so these
        // listeners, bound on the buttons themselves, always run first.
        var removeBtns = document.querySelectorAll('.local-cohort-manager-remove-enrol');
        var enrolIdField = document.getElementById('removeEnrolId');
        var keepGroup = document.getElementById('keepgroup');
        if (removeBtns.length && enrolIdField && keepGroup) {
            var courseHolder = document.getElementById('removeEnrolCourse');
            var userCountHolder = document.getElementById('removeEnrolUsers');
            var groupBlock = document.getElementById('removeEnrolGroupBlock');
            var groupNameHolder = document.getElementById('removeEnrolGroupName');
            Array.prototype.forEach.call(removeBtns, function(removeBtn) {
                removeBtn.addEventListener('click', function() {
                    var hasGroup = removeBtn.getAttribute('data-has-group') === '1';
                    enrolIdField.value = removeBtn.getAttribute('data-enrolid');
                    courseHolder.textContent = removeBtn.getAttribute('data-course');
                    userCountHolder.textContent = removeBtn.getAttribute('data-users');
                    groupNameHolder.textContent = removeBtn.getAttribute('data-group');
                    // The whole group block is meaningless without a group; reset the
                    // checkbox on every opening so a previous row's choice never carries over.
                    groupBlock.classList.toggle('d-none', !hasGroup);
                    keepGroup.checked = false;
                    keepGroup.disabled = !hasGroup;
                });
            });
        }

        // Batch rename confirmation (safe against apostrophes in lang strings).
        var batchBtn = document.getElementById('batchRenameBtn');
        if (batchBtn) {
            batchBtn.addEventListener('click', function(e) {
                var msg = document.getElementById('batchConfirmMsg').textContent;
                if (!confirm(msg)) {
                    e.preventDefault();
                }
            });
        }
    })();
    {{/js}}
</div>
